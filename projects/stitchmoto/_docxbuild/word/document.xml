<w:p><w:pPr><w:spacing w:before="240" w:after="80"/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="AD2B00"/><w:sz w:val="24"/></w:rPr><w:t xml:space="preserve">Q6. </w:t></w:r><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="24"/></w:rPr><w:t>Admin Panel</w:t></w:r></w:p>
<w:p><w:pPr><w:spacing w:after="160"/></w:pPr><w:r><w:rPr><w:color w:val="1A1A1A"/><w:sz w:val="22"/></w:rPr><w:t>The design includes an admin/CMS panel (inventory management, product manager). Should this be built in this same release, or is it planned for a future phase?</w:t></w:r></w:p>
<w:p><w:pPr><w:spacing w:after="60"/></w:pPr><w:r><w:rPr><w:b/><w:color w:val="1A1A1A"/><w:sz w:val="22"/></w:rPr><w:t>Ans:</w:t></w:r></w:p>
<w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="4" w:space="1" w:color="CCCCCC"/></w:pBdr><w:spacing w:after="200"/></w:pPr></w:p>
<w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="4" w:space="1" w:color="CCCCCC"/></w:pBdr><w:spacing w:after="200"/></w:pPr></w:p>
<w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:sz="4" w:space="1" w:color="CCCCCC"/></w:pBdr><w:spacing w:after="200"/></w:pPr></w:p>

